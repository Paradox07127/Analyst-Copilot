# Example front proxy (compose profile "caddy"): gzip, upload cap, SSE-safe.
# For public deployment replace :8080 with your domain so Caddy provisions TLS,
# and configure the app's deployment mode, hosts, origins, and remote auth token.
:8080 {
	encode gzip

	# Keep in sync with MAX_UPLOAD_BYTES (1 GiB) in upload_service.py,
	# plus multipart framing slack.
	request_body {
		max_size 1100MB
	}

	# API, including SSE progress streams: never buffer.
	handle /api/* {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}

	# Static assets and the SPA fallback are served by the app itself.
	handle {
		reverse_proxy app:8000
	}
}
