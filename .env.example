# Copy to .env. The real file is ignored by Git; never commit API keys.

# Select the connection used when the app starts.
# Agent-ready providers: offline | openai | anthropic | deepseek | groq | openrouter
EDA_LLM_PROVIDER=offline

# Provider keys may coexist. The selected provider reads its own key, so do not
# add EDA_LLM_API_KEY here: that generic override would take precedence over all
# provider-specific keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Any model id the endpoint serves is accepted. Ones outside the verified
# catalog get one cheap tool-calling probe before the run spends anything, and
# fall back to the deterministic path if the endpoint refuses a tools payload.
# Omit EDA_LLM_MODEL to use the provider's first known model.
# EDA_LLM_PROVIDER=openai
# EDA_LLM_MODEL=gpt-5.6-sol

# DeepSeek:
# EDA_LLM_PROVIDER=deepseek
# EDA_LLM_MODEL=deepseek-v4-flash

# Optional: use a different data directory. The path must be absolute.
# EDA_WORKSPACE=/absolute/path/to/workspace

# Optional: required only when exposing the app beyond localhost.
# EDA_DEPLOYMENT_MODE=remote
# EDA_ALLOWED_HOSTS=app.example.com
# EDA_ALLOWED_ORIGINS=https://app.example.com
